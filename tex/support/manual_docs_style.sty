\definecolor{manualDocCodeBg}{RGB}{248,248,248}
\definecolor{manualDocCodeBorder}{RGB}{210,210,210}
\ifmanualDocLineNumbers
  \RecustomVerbatimEnvironment{DocCode}{Verbatim}{
    fontsize=\small,
    breaklines=true,
    breakanywhere=true,
    breaksymbolleft={},
    breaksymbolright={},
    frame=single,
    framerule=0.35pt,
    framesep=3pt,
    rulecolor=\color{manualDocCodeBorder},
    fillcolor=\color{manualDocCodeBg},
    numbers=none,
    stepnumber=1,
    numberblanklines=true,
    numbersep=10pt,
    firstnumber=last
  }
  \RecustomVerbatimEnvironment{LinkedDocCode}{Verbatim}{
    fontsize=\small,
    breaklines=false,
    breaksymbolleft={},
    breaksymbolright={},
    frame=single,
    framerule=0.35pt,
    framesep=3pt,
    rulecolor=\color{manualDocCodeBorder},
    fillcolor=\color{manualDocCodeBg},
    numbers=none,
    stepnumber=1,
    numberblanklines=true,
    numbersep=10pt,
    firstnumber=last,
    commandchars=\\\{\}
  }
\else
  \RecustomVerbatimEnvironment{DocCode}{Verbatim}{
    fontsize=\small,
    breaklines=true,
    breakanywhere=true,
    breaksymbolleft={},
    breaksymbolright={},
    frame=single,
    framerule=0.35pt,
    framesep=3pt,
    rulecolor=\color{manualDocCodeBorder},
    fillcolor=\color{manualDocCodeBg},
    numbers=none
  }
  \RecustomVerbatimEnvironment{LinkedDocCode}{Verbatim}{
    fontsize=\small,
    breaklines=false,
    breaksymbolleft={},
    breaksymbolright={},
    frame=single,
    framerule=0.35pt,
    framesep=3pt,
    rulecolor=\color{manualDocCodeBorder},
    fillcolor=\color{manualDocCodeBg},
    numbers=none,
    commandchars=\\\{\}
  }
\fi

