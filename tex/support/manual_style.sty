\newcommand{\manualBibliography}{%
  \bibliographystyle{plainnat}%
  \IfFileExists{tex/generated/references.bib}{%
    \bibliography{tex/generated/references}%
  }{%
    \bibliography{tex/support/references}%
  }%
}

\geometry{
  left=1in,
  right=1in,
  top=1in,
  bottom=1in
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}
\setlength{\headheight}{14pt}
\emergencystretch=1em
\setlength{\LTcapwidth}{\textwidth}

\setlist[itemize,1]{leftmargin=1.5em,itemsep=0.25em,topsep=0.3em}
\setlist[itemize,2]{leftmargin=2.8em,itemsep=0.1em,topsep=0.1em,font=\small}
